{
  "name": "seedcal",
  "version": "0.1.0",
  "description": "Sowing calendar for community gardens: site frost dates, soil temperature and a week-by-week planting plan",
  "license": "MIT",
  "type": "module",
  "bin": {
    "seedcal": "dist/cli.js"
  },
  "files": [
    "dist",
    "data",
    "web"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "demo": "tsx src/cli.ts demo",
    "demo:gaps": "tsx src/cli.ts demo --crops tomato,lettuce,carrot,radish --out web/data/plan-gaps.json",
    "fetch:sample": "tsx src/cli.ts fetch --lat -35.2809 --lon 149.13 --name \"Canberra City Farm\" --out data/climate-canberra.json",
    "serve": "node scripts/serve.mjs web 8080"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sowing-calendar",
    "community-garden",
    "frost-dates",
    "soil-temperature",
    "open-meteo",
    "gardening",
    "food"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}